# Variables de la parte B. Copiar a infra/.env con `make env-b`.
# El archivo real está ignorado por git; este ejemplo no lleva secretos.

# --- Broker Kafka (KRaft, un solo nodo: broker + controller) ---
KAFKA_IMAGE=apache/kafka:4.3.1
# Identidad del cluster KRaft. Fija a propósito: si se deja al azar, cada
# recreación del volumen deja los metadatos inconsistentes con el log.
KAFKA_CLUSTER_ID=X6623DrsQtuXpeaGeMMCSg
KAFKA_EXTERNAL_PORT=29092
KAFKA_ADVERTISED_EXTERNAL_HOST=localhost
KAFKA_LOG_RETENTION_HOURS=168

# Listener interno: contenedores dentro de la red `audiencias` (Flink, dashboard).
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
# Listener externo: procesos del host (producers/, infra/scripts/).
KAFKA_BOOTSTRAP_EXTERNAL=localhost:29092

# --- Producer ---
PRODUCER_ACKS=all
PRODUCER_ENABLE_IDEMPOTENCE=true
PRODUCER_COMPRESSION_TYPE=lz4
PRODUCER_LINGER_MS=10
PRODUCER_BATCH_SIZE=131072
# murmur2_random iguala el particionador por defecto de los clientes Java.
# El de librdkafka (consistent_random, CRC32) repartiría las mismas claves
# de otra forma y partiría un user_id entre particiones.
PRODUCER_PARTITIONER=murmur2_random
PRODUCER_FLUSH_TIMEOUT_SECONDS=30

# --- Event store de B (audit trail; no es el sink de C) ---
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=audiencias
POSTGRES_PASSWORD=audiencias
POSTGRES_DB=audiencias
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://audiencias:audiencias@localhost:5432/audiencias
# Grupo del event store. El de Flink debe ser distinto para que ambos
# reciban el flujo completo en vez de repartírselo.
EVENT_STORE_GROUP_ID=event-store

# --- Consola web (profile tools; fuera de las corridas de benchmark) ---
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
KAFKA_UI_PORT=8080

# --- Flink (infra/compose.flink.yaml) ---
FLINK_IMAGE=flink:2.3.0-scala_2.12-java17
FLINK_UI_PORT=8081
FLINK_PARALLELISM=1
FLINK_TASK_SLOTS=4

# --- Simulador de A (profile sim; escribe JSONL, no habla con Kafka) ---
SIM_SCENARIO=BASE
SIM_AGENTS=120
SIM_DURATION=20
SIM_SPEED=3600
