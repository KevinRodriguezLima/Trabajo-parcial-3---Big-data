{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proyecto-final-3.local/contracts/event.schema.json",
  "title": "Evento de audiencias digitales v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "event_timestamp",
    "ingestion_timestamp",
    "user_id",
    "session_id",
    "agent_profile",
    "source",
    "city",
    "region",
    "scenario",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "event_type": {
      "enum": [
        "LOGIN", "SEARCH", "PAGE_VIEW", "VIEW_PRODUCT", "ADD_TO_CART",
        "REMOVE_FROM_CART", "PURCHASE", "PAYMENT_FAILED", "GPS_UPDATE",
        "IOT_READING", "MOTION_DETECTED", "SOCIAL_POST"
      ]
    },
    "event_timestamp": {"type": "string", "format": "date-time"},
    "ingestion_timestamp": {"type": "string", "format": "date-time"},
    "user_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "agent_profile": {
      "enum": [
        "COMPRADOR_COMPULSIVO", "COMPARADOR", "COMPRADOR_NOCTURNO",
        "CLIENTE_PREMIUM", "CLIENTE_FRECUENTE", "USUARIO_EXPLORADOR",
        "CLIENTE_INDECISO", "CLIENTE_ESTACIONAL"
      ]
    },
    "source": {"enum": ["WEB", "MOBILE", "IOT", "VEHICLE", "POS"]},
    "city": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "scenario": {
      "enum": [
        "BASE", "NAVIDAD", "CYBER_MONDAY", "BLACK_FRIDAY",
        "FIESTAS_PATRIAS", "CAMPANA_ESCOLAR", "DIA_DEL_PADRE"
      ]
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "LOGIN"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/login"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "SEARCH"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/search"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "PAGE_VIEW"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/pageView"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "VIEW_PRODUCT"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/viewProduct"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "ADD_TO_CART"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/addToCart"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "REMOVE_FROM_CART"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/removeFromCart"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "PURCHASE"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/purchase"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "PAYMENT_FAILED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/paymentFailed"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "GPS_UPDATE"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/gpsUpdate"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "IOT_READING"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/iotReading"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "MOTION_DETECTED"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/motionDetected"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "SOCIAL_POST"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/socialPost"}}}
    }
  ],
  "$defs": {
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "is_first_login"],
      "properties": {
        "device": {"type": "string"},
        "is_first_login": {"type": "boolean"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "results_count", "category_filter"],
      "properties": {
        "query": {"type": "string"},
        "results_count": {"type": "integer", "minimum": 0},
        "category_filter": {"type": "string"}
      }
    },
    "pageView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_type", "page_url", "dwell_time_ms"],
      "properties": {
        "page_type": {"type": "string"},
        "page_url": {"type": "string"},
        "dwell_time_ms": {"type": "integer", "minimum": 0}
      }
    },
    "viewProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "product_name", "category", "price", "dwell_time_ms"],
      "properties": {
        "product_id": {"type": "string"},
        "product_name": {"type": "string"},
        "category": {"type": "string"},
        "price": {"type": "number", "minimum": 0},
        "dwell_time_ms": {"type": "integer", "minimum": 0}
      }
    },
    "addToCart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cart_id", "product_id", "product_name", "category", "unit_price",
        "quantity", "cart_size_after", "cart_value_after"
      ],
      "properties": {
        "cart_id": {"type": "string"},
        "product_id": {"type": "string"},
        "product_name": {"type": "string"},
        "category": {"type": "string"},
        "unit_price": {"type": "number", "minimum": 0},
        "quantity": {"type": "integer", "minimum": 1},
        "cart_size_after": {"type": "integer", "minimum": 0},
        "cart_value_after": {"type": "number", "minimum": 0}
      }
    },
    "removeFromCart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cart_id", "product_id", "quantity", "cart_size_after", "cart_value_after"],
      "properties": {
        "cart_id": {"type": "string"},
        "product_id": {"type": "string"},
        "quantity": {"type": "integer", "minimum": 1},
        "cart_size_after": {"type": "integer", "minimum": 0},
        "cart_value_after": {"type": "number", "minimum": 0}
      }
    },
    "purchaseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "product_name", "category", "unit_price", "quantity", "subtotal"],
      "properties": {
        "product_id": {"type": "string"},
        "product_name": {"type": "string"},
        "category": {"type": "string"},
        "unit_price": {"type": "number", "minimum": 0},
        "quantity": {"type": "integer", "minimum": 1},
        "subtotal": {"type": "number", "minimum": 0}
      }
    },
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id", "cart_id", "items", "items_count", "total_units",
        "total_amount", "currency", "payment_method", "time_to_purchase_ms"
      ],
      "properties": {
        "order_id": {"type": "string"},
        "cart_id": {"type": "string"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/purchaseItem"}
        },
        "items_count": {"type": "integer", "minimum": 1},
        "total_units": {"type": "integer", "minimum": 1},
        "total_amount": {"type": "number", "minimum": 0},
        "currency": {"const": "PEN"},
        "payment_method": {"type": "string"},
        "time_to_purchase_ms": {"type": "integer", "minimum": 0}
      }
    },
    "paymentFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "cart_id", "total_amount", "payment_method", "failure_reason", "retry_count"],
      "properties": {
        "order_id": {"type": "string"},
        "cart_id": {"type": "string"},
        "total_amount": {"type": "number", "minimum": 0},
        "payment_method": {"type": "string"},
        "failure_reason": {"type": "string"},
        "retry_count": {"type": "integer", "minimum": 1}
      }
    },
    "gpsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "latitude", "longitude", "speed_kmh"],
      "properties": {
        "device_id": {"type": "string"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "speed_kmh": {"type": "number", "minimum": 0}
      }
    },
    "iotReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "sensor_type", "value", "unit"],
      "properties": {
        "device_id": {"type": "string"},
        "sensor_type": {"type": "string"},
        "value": {"type": "number"},
        "unit": {"type": "string"}
      }
    },
    "motionDetected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "zone", "confidence"],
      "properties": {
        "device_id": {"type": "string"},
        "zone": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "socialPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "post_type", "product_id", "sentiment"],
      "properties": {
        "platform": {"type": "string"},
        "post_type": {"type": "string"},
        "product_id": {"type": "string"},
        "sentiment": {"type": "string"}
      }
    }
  }
}
